{
  "manifest_version": 3,
  "name": "Trip Radar",
  "version": "0.6.0",
  "key": "",
  "description": "Seyahat seçeneklerini tek tıkla kaydet; AI anlamlandırsın, karşılaştırsın, plana koysun.",
  "action": {
    "default_title": "Bu sayfayı geziye kaydet",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://api.frankfurter.dev/*",
    "https://api.frankfurter.app/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Bu sayfayı kaydet"
    }
  }
}
